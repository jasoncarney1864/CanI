# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.venv/
.venv-*/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
htmlcov/
.coverage

# Env / secrets
.env
.env.*
!.env.example

# Kubernetes secret material and locally rendered manifests — these must never be
# committed. The dev secrets bootstrap lives OUTSIDE the repo at ~/.cani/ (see
# runbooks/rotate-dev-secrets.md); rendered-*.yaml are kustomize build artifacts.
*secrets-bootstrap*.yaml
rendered-*.yaml

# Pulumi
infra/**/Pulumi.*.yaml
!infra/**/Pulumi.yaml
.pulumi/

# Node (kustomize/helm helper tooling, if any)
node_modules/

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# App data volumes mounted by docker-compose
.data/
