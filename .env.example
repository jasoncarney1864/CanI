# Copy to .env and fill in real values. Never commit .env.
# All services read config from environment variables only — nothing here is a real secret.

ENV=dev

# --- Postgres (local docker-compose instance in dev) ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=cani
POSTGRES_USER=cani
POSTGRES_PASSWORD=change-me-locally

# --- Qdrant (local docker-compose instance in dev) ---
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=cani_docs_dev

# --- Blob storage (Azurite emulator in dev; real Storage account connection string in cloud) ---
# Note: the "UseDevelopmentStorage=true" shorthand resolves to 127.0.0.1, which only
# works when Azurite runs on the same host as the caller — not across docker-compose
# containers, so this spells out the well-known Azurite dev key with the "azurite"
# service hostname instead.
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://azurite:10000/devstoreaccount1;

# --- Internal token signing (dev-mode stub IdP only; real Entra External ID replaces this in prod) ---
# Generate locally, e.g.: python -c "import secrets; print(secrets.token_urlsafe(48))"
CANI_TOKEN_SIGNING_SECRET=
CANI_SESSION_SECRET=

# --- Azure OpenAI (real — required for embeddings + grounded answers) ---
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=
AZURE_OPENAI_CHAT_DEPLOYMENT=

# --- Azure AI Document Intelligence (real — required for OCR fallback) ---
AZURE_DOCUMENTINTELLIGENCE_ENDPOINT=
AZURE_DOCUMENTINTELLIGENCE_API_KEY=

# --- Service URLs (docker-compose service names in dev) ---
HUB_API_URL=http://hub-api:8001
DOCS_API_URL=http://docs-api:8002
RETRIEVAL_WORKER_URL=http://retrieval-worker:8003
