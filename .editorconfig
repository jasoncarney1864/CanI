root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.py]
indent_size = 4
max_line_length = 110

[*.{js,jsx,ts,tsx,json,css}]
indent_size = 2

[*.{yml,yaml}]
indent_size = 2

[*.{bicep,tf}]
indent_size = 2

[*.sql]
indent_size = 4

[*.md]
indent_size = 2
# Markdown uses trailing double-space for hard line breaks.
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

[*.{ps1,bat,cmd}]
end_of_line = crlf
